# Credenciais da Pluggy (https://dashboard.pluggy.ai → Applications)
# Uso pessoal GRATUITO: conecte seus bancos em https://meu.pluggy.ai e use o conector "MeuPluggy".
# Copie este arquivo para .env e preencha. NUNCA compartilhe o .env.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# true = o botão "Conectar" abre direto o conector gratuito Meu Pluggy
PLUGGY_MEU_PLUGGY=true

# true = mostra também bancos de teste (Pluggy Bank) no widget
PLUGGY_INCLUDE_SANDBOX=false

# Porta local do app
PORT=8765

# Modo nuvem (celular sem o computador ligado) — veja o README, seção "Modo nuvem"
GITHUB_TOKEN=
GITHUB_REPO=
NUVEM_SENHA=

# De quantas em quantas horas o app do computador busca transações novas
SYNC_HORAS=4
